<Project>
  <!--
    GOXF/DeskBox fork only (this file does not exist upstream, so upstream
    version bumps never conflict with it).

    Fork version = upstream base version (<Version> in src/DeskBox/DeskBox.csproj)
                   + 4th segment ForkRevision, e.g. 1.5.9 + 1 => 1.5.9.1.

    Directory.Build.targets is imported after the project body AND after the
    SDK's DefaultAssemblyInfo targets have already derived AssemblyVersion /
    FileVersion / InformationalVersion, so all four properties are set
    explicitly here (a project-level <Version> alone would not propagate).

    ForkRevision can be overridden with /p:ForkRevision=N or a ForkRevision
    environment variable (the release-custom workflow does that). Bump the
    default below when publishing a new fork build on the same upstream base;
    reset it to 1 after upstream bumps <Version>.
  -->
  <PropertyGroup>
    <ForkRevision Condition="'$(ForkRevision)' == ''">3</ForkRevision>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskBox' and '$(ForkRevision)' != ''">
    <ForkBaseVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</ForkBaseVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskBox' and '$(ForkBaseVersion)' != ''">
    <Version>$(ForkBaseVersion).$(ForkRevision)</Version>
    <AssemblyVersion>$(ForkBaseVersion).$(ForkRevision)</AssemblyVersion>
    <FileVersion>$(ForkBaseVersion).$(ForkRevision)</FileVersion>
    <InformationalVersion>$(ForkBaseVersion).$(ForkRevision)</InformationalVersion>
  </PropertyGroup>

  <!--
    GOXF fork: local test channel. Debug builds of DeskBox embed the git
    commit they were built from (AssemblyMetadata ForkGitSha / ForkGitBranch)
    so the app can compare it with the tip of origin/dev. Failure-tolerant:
    no git / not a clone => nothing embedded, the app then reads .git at
    runtime. Release / CI / installer builds skip it (opt in with
    /p:ForkEmbedGitInfo=true).
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DeskBox' and '$(ForkEmbedGitInfo)' == '' and '$(Configuration)' == 'Debug'">
    <ForkEmbedGitInfo>true</ForkEmbedGitInfo>
  </PropertyGroup>

  <Target
    Name="ForkEmbedGitInfoMetadata"
    BeforeTargets="GetAssemblyAttributes"
    Condition="'$(MSBuildProjectName)' == 'DeskBox' and '$(ForkEmbedGitInfo)' == 'true'">
    <Exec
      Command="git rev-parse HEAD"
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      ConsoleToMSBuild="true"
      EchoOff="true"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
      ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ForkGitShaRaw" />
      <Output TaskParameter="ExitCode" PropertyName="ForkGitShaExitCode" />
    </Exec>
    <Exec
      Command="git rev-parse --abbrev-ref HEAD"
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      ConsoleToMSBuild="true"
      EchoOff="true"
      IgnoreExitCode="true"
      IgnoreStandardErrorWarningFormat="true"
      StandardOutputImportance="low"
      StandardErrorImportance="low"
      ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ForkGitBranchRaw" />
      <Output TaskParameter="ExitCode" PropertyName="ForkGitBranchExitCode" />
    </Exec>
    <PropertyGroup>
      <ForkGitSha Condition="'$(ForkGitShaExitCode)' == '0'">$([System.Text.RegularExpressions.Regex]::Match('$(ForkGitShaRaw)', '[0-9a-fA-F]{40,64}').Value)</ForkGitSha>
      <ForkGitBranch Condition="'$(ForkGitBranchExitCode)' == '0'">$(ForkGitBranchRaw.Trim())</ForkGitBranch>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="ForkGitSha" Value="$(ForkGitSha)" Condition="'$(ForkGitSha)' != ''" />
      <AssemblyMetadata Include="ForkGitBranch" Value="$(ForkGitBranch)" Condition="'$(ForkGitSha)' != '' and '$(ForkGitBranch)' != ''" />
    </ItemGroup>
  </Target>
</Project>
